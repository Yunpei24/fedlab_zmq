# ──────────────────────────────────────────────────────────────────────────────
# FedLab ZMQ — .gitignore
# Goal: ship a clean, reproducible artifact (code + configs + tests). Everything
# that is regenerated (results, caches, datasets) or scratch/out-of-scope is
# ignored. NOTE: tests/ is intentionally TRACKED — it holds the canonical
# cost-model regression guardrail (tests/test_flop_cost.py).
# ──────────────────────────────────────────────────────────────────────────────

# ── Python / build ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Virtualenvs ─────────────────────────────────────────────────────────────
venv/
.venv/
env/

# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
*.swp

# ── Datasets (downloaded on demand by datasets/) ──────────────────────────────
data/
data_results/
datasets/cache/

# ── Experiment outputs (regenerate from configs/) ─────────────────────────────
results/
results1/
result_broui/
logs/

# ── Scratch / work-in-progress (not part of the artifact) ─────────────────────
z_*
T_*
aa/
tests_brouillon/
configs/brouillons/
analyze_benchmark.py
newplot-2.png
algorithms/fedpart_be_lora_gs.py
algorithms/fed_grad_align.py
algorithms/fedpart_universal.py

# ── Other papers in this monorepo (read-only, out of scope for this artifact) ──
paper*
# docs/ is scratch/other-paper notes — ignored, EXCEPT the shipped methodology.
docs/*
!docs/methodology_fr.md
!docs/methodology_en.md
!docs/dmd_toubkal.md
examples/

# ── Local / private ───────────────────────────────────────────────────────────
.claude/
notes.txt
parse_metrics.py
SERVER_MASK_FL_IMPLEMENTATION.txt
test_server_mask.py
predoc_presentation_outline.md
output/
tmp/
REPRODUCE_E1_E5.md
AUDIT_algos_efficiency.md
research/
.codex/
ZK_DDP_FL/
TODO_experiences_SC-FAR-DP/

# Paper-1 SC-FAR-DP protocol artifacts are versioned even though the broader
# local research/TODO trees remain ignored.
!configs/scpfar/paper1/
!configs/scpfar/paper1/*.yaml
!configs/scpfar/paper1/README.md
!TODO_experiences_SC-FAR-DP/
TODO_experiences_SC-FAR-DP/*
!TODO_experiences_SC-FAR-DP/README.md
!TODO_experiences_SC-FAR-DP/AUDIT_TOUKBAL_S1_S5.md

# Shipped SC-FAR reference methodology.
!docs/far_reference_suite.md
